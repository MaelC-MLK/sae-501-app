<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Mise à jour de l'événement</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #ffffff; /* hsl(0, 0%, 100%) */
            color: #0a0e1b; /* hsl(224, 71.4%, 4.1%) */
            margin: 0;
            padding: 0;
        }

        .container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f2f5f9; /* hsl(220, 14.3%, 95.9%) */
            border-radius: 8px; /* 0.5rem */
            border: 1px solid #e3e8f0; /* hsl(220, 13%, 91%) */
        }

        h1 {
            color: #7d3cff; /* hsl(262.1, 83.3%, 57.8%) */
        }

        p {
            color: #747b8a; /* hsl(220, 8.9%, 46.1%) */
        }

        ul {
            list-style-type: none;
            padding: 0;
        }

        li {
            background-color: #ffffff; /* hsl(0, 0%, 100%) */
            margin: 10px 0;
            padding: 10px;
            border-radius: 8px; /* 0.5rem */
            border: 1px solid #e3e8f0; /* hsl(220, 13%, 91%) */
        }

        .footer {
            margin-top: 30px;
            text-align: center;
            color: #747b8a; /* hsl(220, 8.9%, 46.1%) */
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Mise à jour de l'événement : {{ event.title }}</h1>
        <p>Bonjour,</p>
        <p>L'événement <strong>{{ event.title }}</strong> a été mis à jour.</p>
        <p>Voici les nouvelles informations :</p>
        <ul>
            {% if event.dateStart %}
                <li>Date de début : {{ event.dateStart|date('d/m/Y H:i') }}</li>
            {% endif %}
            {% if event.dateEnd %}
                <li>Date de fin : {{ event.dateEnd|date('d/m/Y H:i') }}</li>
            {% endif %}
            {% if event.description %}
                <li>Description : {{ event.description }}</li>
            {% endif %}
            {% if event.location %}
                <li>Lieu : {{ event.location }}</li>
            {% endif %}
        </ul>
        <p>Merci de votre compréhension.</p>
        <div class="footer">
            <p>© {{ "now"|date("Y") }} Eventify. Tous droits réservés.</p>
        </div>
    </div>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Invitation à l'événement {{ event_title }}</title>
</head>
<body style="font-family: Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 0;">
    <div style="width: 100%; max-width: 600px; margin: 0 auto; background-color: #ffffff; padding: 20px; border-radius: 10px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);">
        <div style="text-align: center; padding: 10px 0;">
            <h1 style="margin: 0; color: #333333;">Invitation à l'événement</h1>
            <h2 style="color: #555555;">{{ event_title }}</h2>
        </div>
        <div style="text-align: center;">
            <p style="font-size: 16px; color: #666666;">Bonjour,</p>
            <p style="font-size: 16px; color: #666666;">
                Vous êtes invité(e) à participer à l'événement <strong>{{ event_title }}</strong>.
            </p>
            <p style="font-size: 16px; color: #666666;">
                Cliquez sur le bouton ci-dessous pour rejoindre l'événement :
            </p>
            <p>
                <a href="{{ event_link }}" style="display: inline-block; padding: 10px 20px; font-size: 16px; color: #ffffff; background-color: #007bff; text-decoration: none; border-radius: 6px; margin-top: 20px;">
                    Rejoindre l'événement
                </a>
            </p>
        </div>
        <div style="text-align: center; padding: 10px 0; font-size: 12px; color: #999999;">
            <p>&copy; {{ "now"|date("Y") }} Eventify. Tous droits réservés.</p>
        </div>
    </div>
</body>
</html>
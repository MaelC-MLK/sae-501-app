{% extends 'base.html.twig' %}

{% block body %}
    <div class="login">
        <section class="login__box">
            <h1>Admin Login</h1>
            {% if error %}
                <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form action="{{ path('admin_login') }}" method="post" class="login__form">
                <div class="login__form-input">
                    <input type="text" id="username" name="_username" value="{{ last_username }}" placeholder="Username" required autofocus>

                    <input type="password" id="password" name="_password" placeholder="Password" required>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                </div>

                <button type="submit">Login</button>
            </form>
        </section>
    </div>
{% endblock %}